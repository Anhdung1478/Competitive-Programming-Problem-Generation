# Polygon API credentials: polygon.codeforces.com -> Settings -> API keys.
# The server reads these from its own environment and signs every request
# itself; they never reach the model.
POLYGON_API_KEY=
POLYGON_API_SECRET=

# Optional. The one directory a `path=` argument may read from. Unset means
# the server's own working directory, which is where Claude Code was started.
POLYGON_MCP_ROOT=
